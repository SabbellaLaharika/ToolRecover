# Hosted or local OpenAI-compatible API key (OpenAI sk-..., Groq gsk_..., or NVIDIA nvapi-...)
LLM_API_KEY=replace_me

# Model string (OpenAI: gpt-4o-mini | Groq: openai/gpt-oss-20b | NVIDIA: nemotron-3.5-lightning-30b-a3b)
LLM_MODEL_ID=gpt-4o-mini

# Optional custom base URL for OpenAI-compatible providers:
# - Groq: https://api.groq.com/openai/v1
# - NVIDIA: https://integrate.api.nvidia.com/v1
LLM_BASE_URL=

# Application logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
